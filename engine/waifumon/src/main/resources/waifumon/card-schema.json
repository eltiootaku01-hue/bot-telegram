{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WaifuMon Card Definition",
  "type": "object",
  "required": [
    "card_id",
    "name",
    "base_atk",
    "base_def",
    "element_type",
    "skills"
  ],
  "properties": {
    "card_id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "name": {"type": "string", "minLength": 1},
    "base_atk": {"type": "integer", "minimum": 1, "maximum": 10000},
    "base_def": {"type": "integer", "minimum": 1, "maximum": 10000},
    "base_hp": {"type": "integer", "minimum": 1, "maximum": 100000},
    "cost": {"type": "integer", "minimum": 0, "maximum": 1000},
    "element_type": {
      "type": "string",
      "enum": ["fuego", "agua", "tierra", "aire", "hielo", "luz", "oscuridad", "rayo", "mente", "arcano", "neutro"]
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["skill_id", "name", "power", "category"],
        "properties": {
          "skill_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "power": {"type": "integer", "minimum": 1, "maximum": 1000},
          "category": {"type": "string", "enum": ["physical", "special", "defense", "support"]},
          "crit_rate": {"type": "integer", "minimum": 0, "maximum": 100},
          "crit_multiplier": {"type": "number", "minimum": 1.0, "maximum": 4.0},
          "element_multiplier": {"type": "number", "minimum": 0.0, "maximum": 4.0},
          "status_effect": {"type": ["string", "null"]},
          "skill_effect": {
            "type": ["object", "null"],
            "properties": {
              "effect_type": {
                "type": "string",
                "enum": ["damage", "heal", "shield", "apply_status", "draw", "resource"]
              },
              "value": {"type": "integer", "minimum": 0, "maximum": 100000},
              "target": {
                "type": "string",
                "enum": ["self", "enemy", "all_enemies", "all_allies"]
              },
              "formula_id": {"type": ["string", "null"]}
            },
            "required": ["effect_type"],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "status_effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["status_id", "duration_turns", "power"],
        "properties": {
          "status_id": {"type": "string", "enum": ["poison", "bleed", "stun", "shield"]},
          "duration_turns": {"type": "integer", "minimum": 1, "maximum": 10},
          "power": {"type": "integer", "minimum": 0, "maximum": 1000},
          "max_stacks": {"type": "integer", "minimum": 1, "maximum": 5}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
