# BOT-IA runtime
BOT_IA_UNIVERSE=one_neko_punch
BOT_IA_PROVIDER=openai
BOT_IA_ONE_NEKO_PUNCH_ROOT=C:\path\to\one-neko-punch

# Optional local budget used only for BOT-IA's local API-usage percentage display.
# It is NOT the provider's real quota or account balance.
# BOT_IA_API_BUDGET_TOKENS=100000

# Future novel roots: configure them only when their canon folders exist.
# BOT_IA_NEKO_FISH_ONLINE_ROOT=C:\path\to\neko-fish-online
# BOT_IA_NEKO_OF_THE_DEAD_ROOT=C:\path\to\neko-of-the-dead
# BOT_IA_MY_NEKO_ACADEMIA_ROOT=C:\path\to\my-neko-academia
# BOT_IA_ATTACK_ON_NEKO_ROOT=C:\path\to\attack-on-neko

# OpenAI (add more *_API_KEY variables for additional configured accounts)
OPENAI_API_KEY=
# OPENAI_API_KEY_ALT=

# Groq
GROQ_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# Coze
COZE_API_TOKEN=
COZE_BOT_ID=

# Telegram
TELEGRAM_BOT_TOKEN=

# Web / ChatGPT Actions
BOT_IA_API_TOKEN=
BOT_IA_PUBLIC_BASE_URL=https://your-public-https-domain.example
BOT_IA_HOST=127.0.0.1
BOT_IA_PORT=8787

# Optional local provider: only Qwen 3 1B when explicitly enabled in runtime.toml.
OLLAMA_BASE_URL=http://127.0.0.1:11434
