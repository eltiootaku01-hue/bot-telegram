# Telegram bot tokens. The desktop launcher writes these to the local .env file.
BOT_TOKEN=
BOT_TOKEN_CARI=
BOT_TOKEN_SUNNA=
BOT_TOKEN_CAMI=
BOT_TOKEN_CHIE=

# Public Telegram links/usernames used by the desktop setup screen.
BOT_LINK_CARI=
BOT_LINK_SUNNA=
BOT_LINK_CAMI=
BOT_LINK_CHIE=

# Run one Telegram process per identity when launching an individual bot.
BOT_IDENTITY=cari
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# Telegram numeric admin id for private/admin-only workflows.
ADMIN_USER_ID=0
# Private channel/group where Cami receives image assets.
MEDIA_STORAGE_CHAT_ID=0
# Optional Telegram channel id for the "Página + tema del grupo" publication target.
PUBLISH_PAGE_CHAT_ID=0

# Global AI gate. false/off means no Ollama or cloud API calls.
AI_ENABLED=false
# Optional per-bot AI gates. Empty means inherit the global switch.
AI_ENABLED_CARI=
AI_ENABLED_SUNNA=
AI_ENABLED_CAMI=
AI_ENABLED_CHIE=

# Optional AI provider configuration.
# External keys can remain blank when using the local Ollama provider.
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# Local Ollama: no cloud API key is required.
# Example: AI_ENABLED=true and LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:1b
OLLAMA_BASE_URL=http://127.0.0.1:11434
