# Telegram bot tokens. The desktop launcher writes these to the local .env file.
BOT_TOKEN=
BOT_TOKEN_CARI=
BOT_TOKEN_SUNNA=
BOT_TOKEN_CAMI=
BOT_TOKEN_CHIE=
# Optional neutral WorldBot presenter. It is not a character bot.
BOT_TOKEN_WORLD=

# Public Telegram links/usernames used by the desktop setup screen.
BOT_LINK_CARI=
BOT_LINK_SUNNA=
BOT_LINK_CAMI=
BOT_LINK_CHIE=
BOT_LINK_WORLD=

# Run one Telegram process per identity when launching an individual bot.
BOT_IDENTITY=cari
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# SECURITY: explicit group/supergroup allowlist. Comma-separated Telegram chat IDs.
# Empty means no group is authorized. Do not use balance/points as an access-control mechanism.
AUTHORIZED_CHAT_IDS=
# Allow ordinary members to use user-facing private features such as Sunna's games.
ALLOW_USER_PRIVATE_CHAT=true
# Keep the owner-only private access switch available for administrative workflows.
ALLOW_ADMIN_PRIVATE_CHAT=true
# Permite funciones privadas (juegos, puntos, inventario) para usuarios normales.

# IANA timezone used by Ciudad Animals / Café Otaku schedules.
# Persistence continues to use UTC.
BOT_WORLD_TIMEZONE=America/Argentina/Buenos_Aires

# Telegram Mini App HTTP API hosted by Bot Manager.
TMA_API_ENABLED=true
TMA_API_HOST=127.0.0.1
TMA_API_PORT=8765
TMA_BOT_IDENTITY=sunna
TMA_INIT_DATA_MAX_AGE_SECONDS=3600
# Comma-separated exact origins allowed to call the API from a browser.
TMA_ALLOWED_ORIGINS=https://eltiootaku01-hue.github.io
# GitHub Pages origin serving cards and 128x128 combat sprites.
TMA_FRONTEND_BASE_URL=https://eltiootaku01-hue.github.io/bot-telegram
# Technical starter prices; review business pricing before launch.
TMA_PREMIUM_TICKET_PRICE_STARS=10
TMA_STARTER_PACK_PRICE_STARS=25

# Telegram numeric admin id for private/admin-only workflows.
# Canonical owner identity used by Bot Manager and privileged workflows.
MASTER_TELEGRAM_ID=0
MASTER_USERNAME=
# Legacy alias retained for compatibility with existing installations.
ADMIN_USER_ID=0
# Private channel/group where Cami receives image assets.
MEDIA_STORAGE_CHAT_ID=0
# Directory for card images uploaded through the Telegram Mini App.
CARD_ASSETS_DIR=data/card_assets
# Maximum uploaded card image size in bytes (10 MiB by default).
CARD_UPLOAD_MAX_BYTES=10485760
# Optional Telegram channel id for the "Página + tema del grupo" publication target.
PUBLISH_PAGE_CHAT_ID=0
# General/welcome community that must host Chie before the other bots are considered installed.
BASE_GROUP_CHAT_ID=0

# Local card vault / Casa de Comando API. Keep bound to loopback.
VAULT_API_URL=http://127.0.0.1:8766
VAULT_API_TOKEN=
CARD_ASSET_ROOT=data/card_assets
CARD_THUMBNAIL_ROOT=data/card_thumbnails
DIALOGUES_PATH=config/dialogues.json

# Global AI gate. false/off means no Ollama or cloud API calls.
AI_ENABLED=false
# Automatic daily world-curator pass. Keep false unless you explicitly want scheduled AI review.
AI_CURATOR_AUTO=false
# Optional per-bot AI gates. Empty means inherit the global switch.
AI_ENABLED_CARI=
AI_ENABLED_SUNNA=
AI_ENABLED_CAMI=
AI_ENABLED_CHIE=

# Optional AI provider configuration.
# External keys can remain blank when using the local Ollama provider.
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# Local Ollama: no cloud API key is required.
# Example: AI_ENABLED=true and LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:1b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional Meta outbound messaging.
# Current Graph API v26.0 was released by Meta on July 29, 2026; keep this
# configurable so a future API version can be selected without code changes.
META_GRAPH_API_VERSION=v26.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_PAGE_ID=

# Chie's join verification timeout in seconds. Expired users are removed but may rejoin.
HUMAN_VERIFICATION_TIMEOUT_SECONDS=120

# Adaptive anti-raid verification controls.
HUMAN_VERIFICATION_RAID_WINDOW_SECONDS=60
HUMAN_VERIFICATION_RAID_THRESHOLD=5
HUMAN_VERIFICATION_RAID_TIMEOUT_SECONDS=45

# Optional Telegram stickers: {"cari-greeting-01":"CAAC...","sunna-game_success-01":"CAAC..."}
TELEGRAM_STICKER_FILE_IDS_JSON={}
