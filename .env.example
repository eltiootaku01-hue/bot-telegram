# BOT-IA runtime
BOT_IA_UNIVERSE=one_neko_punch
BOT_IA_PROVIDER=openai
BOT_IA_ENABLE_LOCAL_OLLAMA=false
BOT_IA_ONE_NEKO_PUNCH_ROOT=C:\path\to\one-neko-punch

# Optional local progress/usage budgets. These are NOT provider quotas.
# BOT_IA_API_BUDGET_TOKENS=100000
# BOT_IA_TARGET_CHAPTERS=100

# Future novel roots: configure them only when their canon folders exist.
# BOT_IA_NEKO_FISH_ONLINE_ROOT=C:\path\to\neko-fish-online
# BOT_IA_NEKO_OF_THE_DEAD_ROOT=C:\path\to\neko-of-the-dead
# BOT_IA_MY_NEKO_ACADEMIA_ROOT=C:\path\to\my-neko-academia
# BOT_IA_ATTACK_ON_NEKO_ROOT=C:\path\to\attack-on-neko

# OpenAI (add more *_API_KEY variables for additional configured accounts)
OPENAI_API_KEY=
# OPENAI_API_KEY_ALT=

# Groq
GROQ_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# Coze
COZE_API_TOKEN=
COZE_BOT_ID=

# Telegram
TELEGRAM_BOT_TOKEN=
# Schrödinger: token reservado para la intervención directa administrativa.
SCHRODINGER_BOT_TOKEN=
# Destinos activos de la ventana Schrödinger: platform:id:title, separados por coma.
# SCHRODINGER_TARGETS=telegram:-100123456789:Grupo Telegram,discord:123456789012345678:Servidor Discord

# BOTS / Casa de Comando
BOT_TOKEN_CARI=
BOT_TOKEN_CAMI=
BOT_TOKEN_SUNNA=
BOT_TOKEN_CHIE=
BOT_TOKEN_CHLOE=
BOT_TOKEN_SCARLET=

# Web / ChatGPT Actions
BOT_IA_API_TOKEN=
BOT_IA_PUBLIC_BASE_URL=https://your-public-https-domain.example
BOT_IA_HOST=127.0.0.1
BOT_IA_PORT=8787
# Explicit opt-in only: permits plain HTTP on a private LAN when a strong token is set.
# BOT_IA_ALLOW_INSECURE_LAN=true

# Hybrid Playwright mode.
# false = normal headless execution; true = visible Chromium for manual login.
INITIAL_SETUP_MODE=false
# Optional after login: disables image rendering to reduce bandwidth/RAM.
PLAYWRIGHT_DISABLE_IMAGES=false

# Web chat providers used by the 2x2 browser matrix.
BOT_IA_GEMINI_URL=https://gemini.google.com/app
BOT_IA_CHATGPT_URL=https://chatgpt.com/
BOT_IA_GROK_CLAUDE_URL=https://grok.com/

# Optional local provider. Selecting Ollama does not start it automatically.
OLLAMA_BASE_URL=http://127.0.0.1:11434
